# Copy this file to .env and fill in your AMCSD credentials.
# .env is git-ignored, so your credentials never get committed.
# server.js (run with "node server.js") reads this file and exchanges these for
# a token server-side; neither the credentials nor the token reach the browser.
username=
password=

# scripts/symmetry_upload.js uses its own account (the one that can edit the symmetry
# database): either paste a token, or give the login and it gets its own tokens.
symmetry_token=
symmetry_username=
symmetry_password=
